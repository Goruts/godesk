{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Godesk",
  "version": "0.1.0",
  "identifier": "com.godesk.app",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Godesk",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "Copyright Goruts",
    "license": "PolyForm-Small-Business-1.0.0",
    "licenseFile": "../LICENSE.md",
    "shortDescription": "Infinite canvas of terminals",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
